# ===================================
# Django Settings
# ===================================
SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,localhost,127.0.0.1

# ===================================
# HTTPS/Security Settings (Production)
# ===================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=3600

# ===================================
# Google OAuth (Optional)
# ===================================
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-client-id.apps.googleusercontent.com
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-client-secret

# ===================================
# Email Configuration
# ===================================
# Option 1: Gmail SMTP
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Option 2: Custom SMTP (commented out)
#EMAIL_HOST_USER=info@yourdomain.com
#EMAIL_HOST_PASSWORD=your-password
#EMAIL_HOST=mail.yourdomain.com
#EMAIL_PORT=465
#EMAIL_USE_TLS=False
#EMAIL_USE_SSL=True
#DEFAULT_FROM_EMAIL=info@yourdomain.com

# ===================================
# Telegram Bot Configuration
# ===================================
# Bitta bot barcha funksiyalar uchun (recipes, auth, mini-app, linking)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789
TELEGRAM_BOT_USERNAME=YourBot_bot

WEBAPP_URL=https://yourdomain.com/telegram/recipes/
BACKEND_ORIGIN=https://yourdomain.com
BOT_INTERNAL_SECRET=generate-random-secret-key-here

# ===================================
# CORS Settings
# ===================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ===================================
# External API Keys
# ===================================
SPOONACULAR_API_KEY=your-spoonacular-api-key
HF_API_KEY=your-huggingface-api-key

# Edamam API (optional)
EDAMAM_APP_ID=your-app-id
EDAMAM_APP_KEY=your-app-key
EDAMAM_ACCOUNT_USER=your-account
EDAMAM_USER_ID=your-user-id
